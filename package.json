{
  "name": "orch-webui",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:server": "npm run typecheck -w apps/server",
    "typecheck:web": "npm run typecheck -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
