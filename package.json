{
  "name": "orch-webui",
  "version": "0.1.0",
  "private": true,
  "description": "Web UI for the ORCH AI agent orchestrator: tasks, agents, goals, teams and live activity in the browser.",
  "license": "MIT",
  "author": "Oleksandr Shmat (https://github.com/oleksandr-shmat)",
  "homepage": "https://github.com/oleksandr-shmat/orch-webui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oleksandr-shmat/orch-webui.git"
  },
  "bugs": {
    "url": "https://github.com/oleksandr-shmat/orch-webui/issues"
  },
  "keywords": [
    "orch",
    "ai-agents",
    "orchestrator",
    "web-ui",
    "vue",
    "fastify",
    "sse"
  ],
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "npm run dev -w apps/web",
    "dev:server": "npm run dev -w apps/server",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "typecheck:server": "npm run typecheck -w apps/server",
    "typecheck:web": "npm run typecheck -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
